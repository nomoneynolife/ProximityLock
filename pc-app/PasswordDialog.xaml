<Window x:Class="ProximityLock.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开启手机靠近自动解锁" Height="360" Width="460"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,12"
                   Text="锁屏后手机回到附近时, Windows 将自动输入下面的凭据进入桌面。密码用 DPAPI 加密存在本机。仅支持本地账号 (微软邮箱账号无效)。"/>

        <TextBlock Grid.Row="1" Text="Windows 用户名" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox Grid.Row="2" x:Name="UserBox" Padding="6" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Text="域名/计算机名 (本地账号填计算机名)" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox Grid.Row="4" x:Name="DomainBox" Padding="6" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="5" Text="登录密码" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <PasswordBox Grid.Row="6" x:Name="PwdBox" Padding="6" Margin="0,0,0,4"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="90" Height="30" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="确定" Width="90" Height="30" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
