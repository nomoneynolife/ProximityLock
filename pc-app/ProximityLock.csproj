<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProximityLock</RootNamespace>
    <AssemblyName>ProximityLock</AssemblyName>
    <Version>0.5.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- CP DLL 内嵌进 EXE, 一键部署时释放到 C:\ProgramData\ProximityLock -->
    <EmbeddedResource Include="..\cp\ProximityCredentialProvider.dll"
                      Link="cp\ProximityCredentialProvider.dll" />
  </ItemGroup>

</Project>
