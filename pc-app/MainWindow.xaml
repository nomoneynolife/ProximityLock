<Window x:Class="ProximityLock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proximity Lock - 手机靠近解锁(蓝牙连接版)" Height="620" Width="640"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontWeight="SemiBold" Margin="0,0,0,4">
            <Run Text="连接模式设备"/>
            <Run Text="  先在 Windows 蓝牙设置里配对手机, 然后在这里选中它" Foreground="#888888" FontWeight="Normal" FontSize="11"/>
        </TextBlock>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="DeviceBox" Padding="6" VerticalContentAlignment="Center"
                      DisplayMemberPath="Display" SelectionChanged="DeviceBox_SelectionChanged"/>
            <Button Grid.Column="1" x:Name="RefreshDevicesBtn" Content="刷新设备" Width="72" Height="30"
                    Margin="8,0,0,0" Click="RefreshDevicesBtn_Click"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="StartBtn" Content="开始监听" Width="110" Height="32" Margin="0,0,10,0"
                    Click="StartBtn_Click"/>
            <Button x:Name="StopBtn" Content="停止" Width="110" Height="32" Margin="0,0,10,0"
                    IsEnabled="False" Click="StopBtn_Click"/>
            <Button x:Name="TestLockBtn" Content="测试锁屏" Width="110" Height="32" Margin="0,0,10,0"
                    Click="TestLockBtn_Click"/>
            <CheckBox x:Name="AutoStartCheck" Content="开机自启动(静默+自动监听)" VerticalAlignment="Center"
                      Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
        </StackPanel>

        <CheckBox Grid.Row="3" x:Name="AutoUnlockCheck" Margin="0,0,0,12"
                  Content="手机靠近自动解锁 (勾选后自动安装解锁组件, 需 UAC 授权; 仅本地账号)"
                  Checked="AutoUnlock_Changed" Unchecked="AutoUnlock_Changed"/>

        <Border Grid.Row="4" Background="#F4F4F4" CornerRadius="6" Padding="8" VerticalAlignment="Stretch">
            <Grid>
                <TextBlock x:Name="NoSignalText" Foreground="#999999" VerticalAlignment="Top"
                           Text="选择手机后点「开始监听」— 连接在线 = 自动解锁, 断开 = 锁屏"/>
                <ItemsControl x:Name="SignalList"/>
            </Grid>
        </Border>

        <RichTextBox Grid.Row="5" x:Name="LogBox" Margin="0,12,0,0" Background="#FAFAFA"
                     BorderBrush="#DDDDDD" BorderThickness="1" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>

        <TextBlock Grid.Row="6" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="11" Foreground="#999999">
            <Run x:Name="VersionRun" Text="ProximityLock"/>
            <Run Text=" · 开源地址:"/>
            <Hyperlink NavigateUri="https://github.com/nomoneynolife/ProximityLock"
                       RequestNavigate="FooterLink_Click" Foreground="#0066CC" TextDecorations="{x:Null}">
                <Run Text="github.com/nomoneynolife/ProximityLock"/>
            </Hyperlink>
        </TextBlock>
    </Grid>
</Window>
