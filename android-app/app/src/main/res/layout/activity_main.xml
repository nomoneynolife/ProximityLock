<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="未运行 · 点下面按钮开启"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/toggleBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="开始广播"
        android:textSize="16sp" />

    <Switch
        android:id="@+id/autoStartSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="打开 App 自动开始广播"
        android:textSize="14sp"
        android:checked="true" />

    <Button
        android:id="@+id/btnBattery"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:textAllCaps="false"
        android:text="申请电池白名单 (广播更稳定)" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="13sp"
        android:textColor="#888888"
        android:gravity="center"
        android:text="在 Windows 蓝牙设置里配对一次本手机, PC 端选中它即可。\n连接模式: PC 与手机保持蓝牙长连接, 连着=解锁, 断开=锁屏。" />

</LinearLayout>
